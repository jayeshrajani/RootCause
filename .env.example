# Copy to `.env` at the repo root (read by apps/api).
# The frontend reads NEXT_PUBLIC_* variables from apps/web/.env.local.

# --- API (apps/api) ---
ROOTCAUSE_ENVIRONMENT=development
ROOTCAUSE_LOG_LEVEL=INFO
# JSON list of allowed browser origins.
ROOTCAUSE_CORS_ORIGINS=["http://localhost:3000"]
ROOTCAUSE_MAX_IMAGES=3
ROOTCAUSE_MAX_IMAGE_BYTES=5242880

# --- AI analysis (server-side only; never expose to the browser) ---
# auto = use Cerebras when CEREBRAS_API_KEY is set, otherwise the labelled mock.
ROOTCAUSE_ANALYSIS_PROVIDER=auto
CEREBRAS_API_KEY=
# ROOTCAUSE_CEREBRAS_MODEL=qwen-3.8-27b
# ROOTCAUSE_CEREBRAS_REASONING_EFFORT=low
# ROOTCAUSE_ANALYSIS_TIMEOUT_SECONDS=45

# Gemini (planned). Blocked on the LSEG network.
# GEMINI_API_KEY=

# --- Web (apps/web/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
